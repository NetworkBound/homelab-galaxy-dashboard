# ---------------------------------------------------------------------------
# Homelab Galaxy Dashboard — configuration
#
#   cp .env.example .env   &&   edit   &&   set -a; . ./.env; set +a
#
# Three layers, highest first: environment (this file) > config.json (written
# by the browser setup wizard at /setup) > defaults. Anything set here wins
# over the wizard. Only PVE_0_* is required; every other block is optional —
# leave a URL blank and that poller is skipped, and the dashboard renders
# without that layer.
#
# No configuration at all?  `python3 app.py` starts anyway, prints a setup
# token and serves the wizard at /setup.   Want to try it with no
# infrastructure?  `DEMO=1 python3 app.py`.
#
# Never commit your real .env file. This example contains only placeholders.
# ---------------------------------------------------------------------------

# --- Modes -----------------------------------------------------------------
# DEMO=1 serves everything from demo/fixtures: no pollers, no network, no
# validation. Add-ons are skipped in demo mode unless DEMO_ADDONS=1.
# DEMO=0
# DEMO_ADDONS=0
# The browser setup wizard (/setup + /api/setup/*). Set false once configured
# if you prefer; the API is token-gated either way.
SETUP_UI=true
# Token for /api/setup/*. Unset = generated at first start, printed as
# "[setup] token: ..." and stored next to config.json as `setup-token` (0600).
# SETUP_TOKEN=
# Where the wizard reads/writes its file. Default ./config.json, or
# /etc/homelab-galaxy-dashboard/config.json when that path exists (installer).
# CONFIG_FILE=/etc/homelab-galaxy-dashboard/config.json
# Runtime state: history DB, display-mode file, inventory cache. Default: cwd.
# DATA_DIR=/var/lib/homelab-galaxy-dashboard

# --- Brand & screens -------------------------------------------------------
BRAND=GALAXY
# DOMAIN=example.com
TAGLINE=live topology · flows · telemetry
# Name of the internet edge when UniFi reports no ISP name.
WAN_LABEL=ISP
# JSON overrides (config.json is the friendlier place for these):
# UI_PALETTE={"ai": "#ff4fa3", "media": "#38e1ff"}
# UI_CATEGORIES={"ai": ["ollama", "immich"], "lab": ["bench"]}   # merged over the defaults
# UI_NODE_ACCENTS={"pve1": "#5ad7ff", "pve2": "#ffb347"}
# UI_NODE_LABELS={"pve1": "RACK", "pve2": "DESK"}

# --- Proxmox VE (required) -------------------------------------------------
# One block per endpoint; numbering must start at 0 and be contiguous. A
# clustered endpoint contributes every node it reports; standalone hosts need
# one block each. NAME must be the node name as Proxmox knows it.
# Create a READ-ONLY token: Datacenter -> Permissions -> API Tokens,
# then give the user PVEAuditor on / . Never use a root password here.
PVE_0_NAME=pve1
PVE_0_URL=https://10.0.0.10:8006
PVE_0_TOKEN=dashboard@pve!readonly=00000000-0000-0000-0000-000000000000
# PVE_0_LABEL=RACK              # what the screens print (default: the name)
# PVE_0_ACCENT=#5ad7ff          # galaxy colour (default: a palette by index)
# PVE_1_NAME=pve2
# PVE_1_URL=https://10.0.0.11:8006
# PVE_1_TOKEN=dashboard@pve!readonly=00000000-0000-0000-0000-000000000000

# Reserved — not yet applied: all backend requests currently skip TLS
# verification, which accepts Proxmox's self-signed default certificate.
PVE_VERIFY_TLS=false

# --- Zabbix (optional) — host counts, problems, per-host severity -----------
# Zabbix >= 7.0 requires Bearer-token auth; this client handles that for you.
# ZBX_URL=http://10.0.0.20/zabbix/api_jsonrpc.php
# ZBX_USER=dashboard
# ZBX_PASS=

# --- UniFi (optional) — clients, device tree, WAN throughput, topology ------
# UNIFI_URL=https://10.0.0.1
# UNIFI_USER=dashboard
# UNIFI_PASS=
# UNIFI_SITE=default

# --- Frigate NVR (optional) — camera satellites, detector stats, events -----
# FRIGATE_URL=http://10.0.0.30:5000
# A camera NVR on another site, drawn as an external node (optional).
# NP_NVR_IP=10.0.0.200

# --- Ollama instances (optional) — showtime panel + chat box ----------------
# Indexed list; each instance is polled for loaded models and VRAM.
# OLLAMA_0_NAME=chat
# OLLAMA_0_URL=http://10.0.0.40:11434
# OLLAMA_0_GPUS=0                # local NVML GPU indexes it runs on (comma list)
# OLLAMA_0_LABEL=RTX 3080 Ti
# OLLAMA_1_NAME=big
# OLLAMA_1_URL=http://10.0.0.40:11435
# OLLAMA_1_GPUS=0,1
# The chat relay (/api/chat). Defaults to the first instance above.
# OLLAMA_URL=http://10.0.0.40:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Grafana / Prometheus (optional) ---------------------------------------
# GRAFANA_URL=http://10.0.0.50:3000
# GRAFANA_TOKEN=
# Prometheus: node-exporter temperatures plus the telemetry panel (IPMI, SMART,
# ZFS, PBS, unpoller, Gatus, LiteLLM, CrowdSec, Akvorado exporters — whatever
# it scrapes; missing metrics are simply null). Also /api/prom passthrough.
# PROM_URL=http://10.0.0.51:9090

# --- Topology (optional) ---------------------------------------------------
# A JSON document describing your SNMP topology, e.g. exported from LibreNMS.
# See docs/data-sources.md for the expected shape.
# NETMAP_URL=http://10.0.0.60/netmap.json

# Any managed switch or router, polled directly over SNMP (needs: pip install
# pysnmp; v3 privacy also needs: pip install cryptography). Indexed list; only
# these addresses are ever contacted. Real nodes with ports, measured rates and
# LLDP/CDP links, merged onto whatever UniFi/Proxmox already know by MAC/address.
# SNMP_0_HOST=10.0.0.2
# SNMP_0_NAME=core-sw
# SNMP_0_VERSION=2c             # 2c or 3
# SNMP_0_COMMUNITY=             # v2c read-only community (secret)
# SNMP_0_ROLE=switch            # switch | router | gateway | ap
# SNMP_1_HOST=10.0.0.3
# SNMP_1_VERSION=3
# SNMP_1_USER=dashboard
# SNMP_1_AUTH_PROTO=sha256      # none | md5 | sha | sha224 | sha256 | sha384 | sha512
# SNMP_1_AUTH_PASS=             # secret
# SNMP_1_PRIV_PROTO=aes         # none | des | 3des | aes | aes192 | aes256
# SNMP_1_PRIV_PASS=             # secret
# SNMP_1_PORT=161
# SNMP_POLL_S=30                # counters and status; structure + neighbours every 5 min

# ntopng, for host-to-host flow arcs between planets.
# NTOPNG_URL=http://10.0.0.10:3001
# NTOPNG_USER=admin
# NTOPNG_PASS=
# NTOPNG_IFNAME=vmbr0
# NTOPNG_IFID=0                  # fallback interface id if the name cannot be resolved (0 = none)

# Active ICMP probing with fping: RTT/jitter/loss per node and a subnet sweep
# that finds hosts no controller lists. Needs the fping binary.
ENABLE_PROBE=false

# TLS certificates to watch expiry on. Hostnames only — comma separated.
# NP_CERT_HOSTS=example.com,mail.example.com:993

# Topology tuning (JSON; config.json topology.* is the friendlier place):
# TOPOLOGY_CLIENT_OVERRIDES=[{"mac": "aa:bb:cc:dd:ee:01", "alt_macs": ["aa:bb:cc:dd:ee:02"], "cat": "pc", "label": "Desktop"}]
# TOPOLOGY_ALIASES={"Gateway Console": "Core Gateway"}
# TOPOLOGY_CLIENT_CAP=120

# --- The internet edge (optional) ------------------------------------------
# cloudflared tunnel metrics (cloudflared --metrics 0.0.0.0:20241).
# CLOUDFLARED_METRICS_URL=http://10.0.0.36:20241/metrics
# CrowdSec alerts/decisions with geo, exported by deploy/edge/galaxy-cs-export.sh
# and served read-only by nginx (base URL of alerts.json / decisions.json).
# CROWDSEC_EXPORT_URL=http://10.0.0.36:8099/_cs
# Akvorado flow collector console: top external destinations, countries, ASNs.
# AKVORADO_URL=http://10.0.0.61:8080

# --- Security & audience (optional) ----------------------------------------
# A findings API (/api/stats/summary + /api/findings) that sets the threat level.
# SECMON_URL=http://10.0.0.62:8765
# IANA zone for naive timestamps in its findings.
# SECMON_TZ=UTC
# Real unique visitors from Cloudflare zone analytics (token needs Analytics:Read).
# CF_API_TOKEN=
# CF_ZONE_ID=
# Fallback/alternative: audience.json written on your origin from its nginx log
# by deploy/edge/galaxy-audience-export.py.
# AUDIENCE_URL=http://10.0.0.36:8099/_cs/audience.json

# --- Emby / Jellyfin (optional) — sessions and what is playing -------------
# EMBY_URL=http://10.0.0.80:8096
# EMBY_API_KEY=

# --- Lights, presence, alert mode ------------------------------------------
# Room lights follow the screens (deploy/lights/galaxy-lights.py polls /api/lightstate).
ENABLE_LIGHTS=false
# A screen that has not published a colour for this long is reported stale.
LIGHTS_STALE_S=45
# POST /api/presence from a motion sensor (deploy/homeassistant/presence.yaml.example):
# one positive report keeps the screens awake for PRESENCE_GRACE_S; an "empty"
# report older than PRESENCE_STALE_S is ignored (fails open).
PRESENCE_GRACE_S=900
PRESENCE_STALE_S=600
# Alert mode: a NEW Zabbix problem at/above this severity (0-5) or a NEW device
# down flips the wall red; problems matching ALERT_IGNORE mean busy, not broken.
ALERT_SEV=3
ALERT_IGNORE=^High CPU

# --- Features --------------------------------------------------------------
ENABLE_NEXUS=true              # the second screen (/nexus)
ENABLE_DOOM=true               # DOOM takeover; also needs static/doom/js-dos.js (tools/fetch-doom.sh)
ENABLE_CAMERAS=true            # camera satellites (needs FRIGATE_URL)
ENABLE_THREATS=true            # threat feed (needs CrowdSec export or Security Monitor)
ENABLE_CINEMATICS=false        # scripted camera moves every few laps; per-screen override ?cinematics=on
CINEMATICS_LAPS=3              # tour laps between cinematic moves (1..50)

# --- Extra GPUs on other machines (optional) -------------------------------
# Requires nvidia_gpu_exporter on the remote host.
# GPUX_0_NAME=rig-2
# GPUX_0_URL=http://10.0.0.70:9835/metrics

# --- Extra hosts shown with an Ollama / node_exporter readout (optional) ----
# Guests whose name contains one of AI_MARKERS are discovered automatically.
# AISRV_0_NAME=rig-2
# AISRV_0_IP=10.0.0.70
# AI_MARKERS=ollama,vllm,localai,llamacpp,llama-cpp,text-generation,tabbyapi
# AI_OLLAMA_PORT=11434
# AI_NODE_PORT=9100

# --- Service health pips (optional) ----------------------------------------
# category is one of: ai media network monitor web infra (or one you added).
# GUEST (optional) is an exact guest name: the URL host is replaced by that
# guest's current IP from the live inventory, so a moved container is followed.
# SVC_0_NAME=grafana
# SVC_0_CATEGORY=monitor
# SVC_0_URL=http://10.0.0.50:3000/api/health
# SVC_0_GUEST=grafana
# SVC_1_NAME=jellyfin
# SVC_1_CATEGORY=media
# SVC_1_URL=http://10.0.0.80:8096/System/Info/Public

# --- Fleet: arbitrary host:port reachability checks (optional) --------------
# FLEET_0_NAME=build-runner
# FLEET_0_HOST=10.0.0.90
# FLEET_0_PORT=22
# Optional JSON endpoint whose keys are rendered in the same panel:
# FLEET_STATS_URL=http://10.0.0.90:8088/stats

# --- Add-ons ---------------------------------------------------------------
# Every addons/<id>.py is loaded (see addons/README.md). Another directory:
# ADDONS_DIR=/etc/homelab-galaxy-dashboard/addons
# The shipped example_http_json add-on is enabled by setting:
# ADDON_HTTP_URL=http://10.0.0.90:8088/stats
# ADDON_HTTP_KEYS=queue.depth=Queue,workers,uptime
# ADDON_HTTP_TITLE=Build runner

# --- Access control (optional) ---------------------------------------------
# The dashboard shows your whole infrastructure and has no login of its own.
# The usual answer is a reverse proxy, SSO or a trusted VLAN in front of it,
# and that advice has not changed. This is the belt-and-braces version:
# set a key and every page, API route and stream requires it.
#   * blank (the default) -> no gate at all, exactly as before
#   * set                 -> send it as an X-API-Key header, or visit /login
#                            once in a browser to get a session cookie
# Generate one:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# /setup keeps its own separate token (SETUP_TOKEN above) either way.
# DASH_API_KEY=

# --- Universe registry and tour (all optional) ------------------------------
# /api/universe groups every device into systems: the network core, one galaxy
# per Proxmox node, home clients, and any remote sites declared here.
# UNIVERSE_SITES=[{"id": "branch", "label": "Branch office", "cidr": "10.0.3.0/24"}]
# UNIVERSE_CAMERA_SITE=branch          # site id the NVR cameras live at
# Bench gear: a LAB badge, never counted as an outage, never red.
# UNIVERSE_LAB_GROUPS=Lab              # Zabbix host groups
# UNIVERSE_LAB_HOSTS=lab-sw-1,10.0.0.166
# UNIVERSE_LAB_VMIDS=977,pve1:978      # Proxmox guests (a guest tagged `lab` counts too)
# Site-to-site tunnels whose Zabbix interface items measure traffic between systems.
# UNIVERSE_TUNNELS=[{"host": "branch-gw", "if": "wg0", "local": "sys:core", "remote": "sys:branch", "label": "WireGuard core - branch"}]
# UNIVERSE_NAME_PREFIXES=Acme          # words dropped from on-screen short names ("Acme UDM" -> "UDM")
# UNIVERSE_DIR=                        # slot store + optional operator files; default DATA_DIR
# UI_FEATURED_NODE=pve2                # node with one tour stop per guest category (default: most guests)
# TOUR_ASPECTS=asp:internet,asp:security,asp:wifi,asp:storage
# TOUR_ANCHORS={"asp:ai": "vm:pve1:111"}
# TOUR_TZ=Europe/Berlin                # clock times on screen; default: server local time

# --- Local behaviour -------------------------------------------------------
# 0.0.0.0 means every interface. With no DASH_API_KEY set, that is the whole
# inventory offered to anything that can reach the port, and the app says so
# loudly at startup. 127.0.0.1 + a reverse proxy is the quiet alternative.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
# Pollers use fixed cadences (POLL_INTERVAL is reserved). METRICS_DB and
# HISTORY_DAYS control the SQLite history store path and retention window.
POLL_INTERVAL=20
# METRICS_DB=metrics.db          # default <DATA_DIR>/metrics.db
HISTORY_DAYS=7

# NVML GPU telemetry panels. Set false on a host with no NVIDIA GPU.
ENABLE_GPU=true
# Offscreen EGL render of the scene to static/gpu_scene.png.
# Needs moderngl, numpy and Pillow (commented out in requirements.txt).
ENABLE_GPU_RENDER=false
