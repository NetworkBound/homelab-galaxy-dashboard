# ---------------------------------------------------------------------------
# Homelab Galaxy Dashboard — configuration
#
#   cp .env.example .env   &&   edit   &&   set -a; . ./.env; set +a
#
# Only PVE_0_* is required. Every other block is optional: leave a URL blank and
# that poller is skipped, and the dashboard renders without that layer.
# Never commit your real .env file. This example intentionally contains only placeholders.
# ---------------------------------------------------------------------------

# --- Proxmox VE (required) -------------------------------------------------
# One block per node; numbering must start at 0 and be contiguous.
# Create a READ-ONLY token: Datacenter -> Permissions -> API Tokens,
# then give the user PVEAuditor on / . Never use a root password here.
PVE_0_NAME=pve1
PVE_0_URL=https://10.0.0.10:8006
PVE_0_TOKEN=dashboard@pve!readonly=00000000-0000-0000-0000-000000000000
# PVE_1_NAME=pve2
# PVE_1_URL=https://10.0.0.11:8006
# PVE_1_TOKEN=dashboard@pve!readonly=00000000-0000-0000-0000-000000000000

# Reserved — not yet applied: all backend requests currently skip TLS
# verification, which accepts Proxmox's self-signed default certificate.
PVE_VERIFY_TLS=false

# --- Zabbix (optional) — host counts, problems, per-host severity -----------
# Zabbix >= 7.0 requires Bearer-token auth; this client handles that for you.
# ZBX_URL=http://10.0.0.20/zabbix/api_jsonrpc.php
# ZBX_USER=dashboard
# ZBX_PASS=

# --- UniFi (optional) — client count, devices, WAN throughput ---------------
# UNIFI_URL=https://10.0.0.1
# UNIFI_USER=dashboard
# UNIFI_PASS=
# Reserved — not yet applied: the poller always queries the "default" site.
# UNIFI_SITE=default

# --- Frigate NVR (optional) — live camera JPEGs as orbiting satellites ------
# FRIGATE_URL=http://10.0.0.30:5000

# --- Ollama (optional) — backs the in-scene chat box ------------------------
# The chat relay requests this model name from Ollama.
# OLLAMA_URL=http://10.0.0.40:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Grafana / Prometheus (optional) ---------------------------------------
# GRAFANA_URL=http://10.0.0.50:3000
# GRAFANA_TOKEN=
# PROM_URL=http://10.0.0.51:9090

# --- Topology (optional) ---------------------------------------------------
# A JSON document describing your SNMP topology, e.g. exported from LibreNMS.
# See docs/data-sources.md for the expected shape.
# NETMAP_URL=http://10.0.0.60/netmap.json

# ntopng, for host-to-host flow arcs between planets.
# NTOPNG_URL=http://10.0.0.10:3001
# NTOPNG_USER=admin
# NTOPNG_PASS=
# NTOPNG_IFNAME=vmbr0

# NVR address for the topology view, if the NVR is not on the main LAN.
# NP_NVR_IP=10.0.0.30

# TLS certificates to watch expiry on. Hostnames only — comma separated.
# NP_CERT_HOSTS=example.com,mail.example.com:993

# --- Extra GPUs on other machines (optional) -------------------------------
# Requires nvidia_gpu_exporter on the remote host.
# GPUX_0_NAME=rig-2
# GPUX_0_URL=http://10.0.0.70:9835/metrics

# --- Extra hosts shown with an Ollama / node_exporter readout (optional) ----
# AISRV_0_NAME=rig-2
# AISRV_0_IP=10.0.0.70

# --- Service health pips (optional) ----------------------------------------
# category is one of: ai media network monitor web infra
# SVC_0_NAME=grafana
# SVC_0_CATEGORY=monitor
# SVC_0_URL=http://10.0.0.50:3000/api/health
# SVC_1_NAME=jellyfin
# SVC_1_CATEGORY=media
# SVC_1_URL=http://10.0.0.80:8096/System/Info/Public

# --- Fleet: arbitrary host:port reachability checks (optional) --------------
# FLEET_0_NAME=build-runner
# FLEET_0_HOST=10.0.0.90
# FLEET_0_PORT=22
# Optional JSON endpoint whose keys are rendered in the same panel:
# FLEET_STATS_URL=http://10.0.0.90:8088/stats

# --- Local behaviour -------------------------------------------------------
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
# Pollers use fixed cadences. METRICS_DB and HISTORY_DAYS control the SQLite
# history store path and retention window.
POLL_INTERVAL=20
METRICS_DB=metrics.db
HISTORY_DAYS=7

# NVML GPU telemetry panels. Set false on a host with no NVIDIA GPU.
ENABLE_GPU=true
# Offscreen EGL render of the scene to static/gpu_scene.png.
# Needs moderngl, numpy and Pillow (commented out in requirements.txt).
ENABLE_GPU_RENDER=false
