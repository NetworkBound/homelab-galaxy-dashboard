[Unit]
Description=Homelab Galaxy Dashboard
Documentation=https://github.com/NetworkBound/homelab-galaxy-dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dashboard
Group=dashboard
WorkingDirectory=/opt/homelab-galaxy-dashboard

# Credentials live here, mode 0600, owned by the service account.
EnvironmentFile=/etc/homelab-galaxy-dashboard/env

# /api/setup/apply re-executes this same process (os.execv): the PID survives,
# systemd sees nothing. Restart=always still covers a crash.
ExecStart=/opt/homelab-galaxy-dashboard/.venv/bin/python app.py
Restart=always
RestartSec=5

# The dashboard is read-only against every backend; give it a read-only system too.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# It writes the SQLite history store, the display-mode file and the inventory
# cache (DATA_DIR), plus config.json + setup-token when the wizard is used.
ReadWritePaths=/var/lib/homelab-galaxy-dashboard /etc/homelab-galaxy-dashboard

StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-dashboard

[Install]
WantedBy=multi-user.target
