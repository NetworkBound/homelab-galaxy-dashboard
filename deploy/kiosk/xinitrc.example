#!/bin/bash
# Dual kiosk .xinitrc: screen :0.0 = the wall (index.html), screen :0.1 = /nexus.
# Copy to the kiosk user's ~/.xinitrc (kiosk.service runs `startx ~/.xinitrc`).
# Needs: chromium, openbox, unclutter, xrandr, curl.
DASH=${DASHBOARD_URL:-http://127.0.0.1:8080}
OUT0=${KIOSK_OUTPUT0:-HDMI-0}          # xrandr output name on screen 0 (`DISPLAY=:0.0 xrandr`)
OUT1=${KIOSK_OUTPUT1:-HDMI-0}          # xrandr output name on screen 1 (`DISPLAY=:0.1 xrandr`)
PROFILE=${KIOSK_PROFILE_DIR:-$HOME/.config}

# --- screen 0 (primary kiosk monitor)
xrandr --output "$OUT0" --mode 1920x1080 --rate 60 2>/dev/null || true
xset -dpms; xset s off; xset s noblank
openbox-session &
# unclutter handles every screen of the display by default; one instance only
( while true; do unclutter -idle 0.5; sleep 5; done ) &

# --- screen 1 (second screen): separate X screen, own window-manager instance
if [ -e /tmp/.X11-unix/X0 ] && DISPLAY=:0.1 xdpyinfo >/dev/null 2>&1; then
  DISPLAY=:0.1 xrandr --output "$OUT1" --mode 3840x2160 --rate 60 2>/dev/null || true
  DISPLAY=:0.1 openbox &
  HAVE_SCREEN1=1
fi

# Cold boot: wait until the dashboard is serving before launching the browsers,
# so the wall never shows a connection error. Any HTTP answer counts as serving
# — `curl -f` would spin here forever once DASH_API_KEY is set, because the
# gate answers 401 and that is still a dashboard that is up.
until [ -n "$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "$DASH/" | grep -v '^000$')" ]; do
  sleep 2
done

COMMON=(--kiosk --no-first-run --noerrdialogs --disable-infobars --disable-session-crashed-bubble
        --password-store=basic --check-for-update-interval=31536000)
# add --no-sandbox only if the kiosk user is root (not recommended)

# Chrome DevTools, off unless you ask for it. This used to be on permanently,
# with --remote-allow-origins=* alongside it, and that pair is worth being
# explicit about: the origin check is the only thing stopping a page the kiosk
# browser has open from opening the DevTools WebSocket itself. Disable it and
# any script running in that browser drives the whole browser — reads every
# tab, every cookie, and navigates to file:// to read the disk as the kiosk
# user. The flag buys nothing for the documented use, because a CDP client
# that is not a browser (the QA scripts, puppeteer, a Python driver) sends no
# Origin header and never needed it.
#
# Turn it on for a debugging session with KIOSK_DEBUG_PORT=9222, and reach it
# over an SSH tunnel: it is bound to loopback and still unauthenticated, so
# anything else with an account on this host can take the browser.
DEBUG0=(); DEBUG1=()
if [ -n "${KIOSK_DEBUG_PORT:-}" ]; then
  DEBUG0=(--remote-debugging-address=127.0.0.1 --remote-debugging-port="$KIOSK_DEBUG_PORT")
  DEBUG1=(--remote-debugging-address=127.0.0.1 --remote-debugging-port="$((KIOSK_DEBUG_PORT + 1))")
fi

# primary kiosk loop
(
  while true; do
    rm -f "$PROFILE/chromium-kiosk/Singleton"* 2>/dev/null
    chromium "${COMMON[@]}" "${DEBUG0[@]}" --user-data-dir="$PROFILE/chromium-kiosk" --app="$DASH"
    sleep 2
  done
) &

# second-screen loop
if [ -n "$HAVE_SCREEN1" ]; then
  (
    while true; do
      rm -f "$PROFILE/chromium-nexus/Singleton"* 2>/dev/null
      DISPLAY=:0.1 chromium "${COMMON[@]}" "${DEBUG1[@]}" --force-device-scale-factor=2 \
        --user-data-dir="$PROFILE/chromium-nexus" --app="$DASH/nexus"
      sleep 2
    done
  ) &
fi

wait
